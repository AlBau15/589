# Dependencias: npm install (ver package.json)
# Contrato: Foundry (ver docs/contrato.md)

PORT=3000
DATABASE_URL=postgres://usuario:clave@localhost:5432/pagos
TRUST_PROXY_HOPS=1
EJECUTAR_TRABAJADORES=1
ADMIN_API_SECRET=cambia-este-secreto-largo-de-tesoreria

# Privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Arbitrum
ARBITRUM_RPC_URL=
ARBITRUM_TESTNET=0
CONTRATO_PAGOS=0x...
OPERADOR_PRIVATE_KEY=0x...
ORDEN_VIGENCIA_SEGUNDOS=900             # tiempo para pagar una orden antes de que caduque
# USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# Juno (Mint Platform) y Bitso Payouts
JUNO_BASE_URL=https://stage.buildwithjuno.com
BITSO_API_URL=https://api-stage.bitso.com
JUNO_ENTORNO=stage
JUNO_API_KEY=
JUNO_API_SECRET=
JUNO_DEPOSIT_ADDRESS=0x...

# Bridge & Ruta B (MXNB -> USDC -> ACH USD)
BRIDGE_API_KEY=
BRIDGE_CUSTOMER_ID=
BRIDGE_EXTERNAL_ACCOUNT_ID=
BRIDGE_RETURN_ADDRESS=0x...
BRIDGE_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
RUTA_B_MODO_RETIRO=bitso_api            # bitso_api | onchain_tesoreria
# BITSO_BRIDGE_CONTACT_ID=              # opcional: ID de contacto beneficiario en Bitso
# TESORERIA_USDC_PRIVATE_KEY=0x...      # solo si RUTA_B_MODO_RETIRO=onchain_tesoreria
